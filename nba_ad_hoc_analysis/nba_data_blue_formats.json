{
    "name": "NBA Digital Dashboard",
    "dataColors": [
      "#024084", "#64C6B7", "#D25B6F", "#FFD067", "#5640AC", "#6496CC",
      "#B6F4EB", "#A73548", "#3599B8", "#DFBFBF", "#4AC5BB", "#5F6B6D",
      "#FB8281", "#F4D25A", "#7F898A", "#A4DDEE", "#FDAB89", "#B687AC",
      "#28738A", "#A78F8F", "#168980", "#293537", "#BB4A4A", "#B59525",
      "#475052", "#6A9FB0", "#BD7150", "#7B4F71", "#1B4D5C", "#706060",
      "#0F5C55", "#1C2325"
    ],
    "visualStyles": {
      "page": {
        "*": {
          "outspace": [
            { "color": { "solid": { "color": "#F0F4FF" } } }
          ],
          "canvasSize": {
            "type": "Custom",
            "width": 1280,
            "height": 2000
          },
          "pageBackground": {
            "color": { "solid": { "color": "#F0F4FF" } },
            "transparency": 0
          }
        }
      },
      "*": {
        "*": {
          "filterCard": [
            {
              "$id": "Available",
              "backgroundColor": { "solid": { "color": "#A29B9B" } },
              "transparency": 0
            }
          ],
          "padding": [
            {
              "top": 5
            }
          ]
        },
        "title": [
          {
            "fontSize": 14,
            "fontFace": "Arial",
            "fontColor": { "solid": { "color": "#050505" } },
            "alignment": "Center"
          }
        ]
      },
      "tableEx": {
        "*": {
          "grid": [
            {
              "vertical": true,
              "horizontal": true,
              "rowPadding": 2
            }
          ]
        }
      },
      "matrix": {
        "*": {
          "grid": [
            {
              "vertical": true,
              "horizontal": true,
              "rowPadding": 2
            }
          ]
        }
      }
    },
    "textClasses": {
      "title": { "fontFace": "Arial", "color": "#050505" },
      "callout": { "fontSize": 35, "fontFace": "Arial" },
      "label": { "fontFace": "Arial" }
    }
  }  
